{
  "name": "omnicam",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --logLevel=info --dotenv frontend/.env",
    "start": "node frontend/.output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "style-check": "prettier --check **/*.{vue,ts,json,js,yaml,md,sql}",
    "format": "prettier --write **/*.{vue,ts,json,js,yaml,md,sql}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sqlc": "go run ./tools/clean_sqlc && sqlc generate && echo done",
    "swagger": "serve -s docs -l 8000",
    "proto": "node tools/gen_proto/main.js all",
    "proto:backend": "node tools/gen_proto/main.js back",
    "proto:frontend": "node tools/gen_proto/main.js front",
    "docker:all:up": "docker compose --env-file observability/.env.observability -f docker-compose.yaml -f observability/docker-compose.observability.yaml up -d",
    "docker:all:down": "docker compose --env-file observability/.env.observability -f docker-compose.yaml -f observability/docker-compose.observability.yaml down",
    "docker:all:up:cached": "docker compose --env-file observability/.env.observability -f docker-compose.yaml -f observability/docker-compose.observability.yaml up -d --no-build --pull never",
    "docker:all:down:v": "docker compose -f docker-compose.yaml -f observability/docker-compose.observability.yaml down -v",
    "docker:obs:up": "docker compose -f observability/docker-compose.observability.yaml up -d",
    "docker:obs:down": "docker compose -f observability/docker-compose.observability.yaml down"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.1",
    "@nuxtjs/color-mode": "^3.5.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-fetch": "^0.218.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.218.0",
    "@opentelemetry/propagator-b3": "^2.7.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@t3-oss/env-nuxt": "^0.13.8",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/vue-table": "^8.21.3",
    "@tresjs/cientos": "^5.4.0",
    "@tresjs/core": "^5.5.0",
    "@vueuse/core": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "gsap": "^3.13.0",
    "lucide-vue-next": "^0.541.0",
    "nuxt": "^4.3.1",
    "papaparse": "^5.5.3",
    "reka-ui": "^2.7.0",
    "shadcn-ui": "^0.9.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "three-csg-ts": "^3.2.0",
    "three-mesh-bvh": "^0.9.9",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.0",
    "validator": "^13.15.35",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.8.0",
    "@types/node": "^24.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/validator": "^13.15.10",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "prettier-plugin-embed": "^0.5.0",
    "prettier-plugin-sql": "^0.19.2",
    "sass-embedded": "^1.93.3",
    "shadcn-nuxt": "^2.2.0",
    "sql-formatter": "^15.6.9",
    "ts-proto": "^2.7.7",
    "vite-tsconfig-paths": "^6.0.4"
  }
}
